# To be used with Ansible to authenticate to Azure and manage resources. 
# Fill in the placeholders with your actual Azure credentials an set as environment variables before running Ansible playbooks that interact with Azure.

AZURE_CLIENT_ID=<service_principal_client_id>
AZURE_SECRET=<service_principal_password>
AZURE_SUBSCRIPTION_ID=<azure_subscription_id>
AZURE_TENANT=<azure_tenant_id>